<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} -- %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Silence Apache HttpClient wire/header logging (this is your TLS garbage) -->
    <logger name="org.apache.hc.client5.http.wire" level="OFF" />
    <logger name="org.apache.hc.client5.http.headers" level="OFF" />
    <logger name="org.apache.hc.client5" level="WARN" />

    <!-- Reduce WebDriverManager noise -->
    <logger name="io.github.bonigarcia.wdm" level="WARN" />

    <!-- Keep your own framework logs visible -->
    <logger name="framework" level="INFO" />

    <root level="WARN">
        <appender-ref ref="CONSOLE" />
    </root>
</configuration>